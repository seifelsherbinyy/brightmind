# BrightMind environment template
# Copy to .env and set real values.

# Required: Slack Socket Mode tokens
SLACK_BOT_TOKEN=xoxb-your-real-token
SLACK_APP_TOKEN=xapp-your-real-token

# Optional: OpenClaw bridge
OPENCLAW_ENABLED=false
OPENCLAW_DRY_RUN=true
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_API_KEY=

# Local LLM runtime
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=D:/ollama/models
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# App paths (all heavy paths should be on D:)
BRIGHTMIND_PROJECT_ROOT=
BRIGHTMIND_LOGS_DIR=
BRIGHTMIND_CACHE_DIR=
BRIGHTMIND_DATA_DIR=D:/brightmind/data
BRIGHTMIND_CONFIG_PATH=

# Runtime behavior
BRIGHTMIND_LOG_LEVEL=INFO
BRIGHTMIND_GATEWAY_TIMEOUT_SEC=30
BRIGHTMIND_GATEWAY_RETRIES=2
